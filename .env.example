# =============================================================================
# Autotributo — ejemplo de configuración local (Docker)
# Copiar a .env:  cp .env.example .env && make key
# NUNCA subir .env al repositorio.
# =============================================================================

APP_NAME=Autotributo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona horaria de la app en UTC (regla: persistir UTC, mostrar America/Guayaquil).
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC

# Tenancy (ADR-0006): el MVP corre en modo single-tenant (un estudio por
# despliegue), pero el esquema y el scoping ya llevan tenant_id. El modo multi
# se activa después sin migrar datos.
TENANCY_MODE=single                 # single | multi
TENANCY_DEFAULT_SLUG=demo           # estudio provisionado por app:provision

# Modo multi (reservado; no activar en el MVP):
# APP_ROOT_DOMAIN=localhost
# TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,autotributo.test
# TENANCY_IDENTIFICATION=subdomain # subdomain | header | both

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Base de datos -----------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=autotributo
DB_USERNAME=autotributo
DB_PASSWORD=secret

# --- Caché, sesiones y colas -------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Almacenamiento de objetos ----------------------------------------------
# En local se usa el disco (storage/app/private) por defecto: sin contenedores
# extra ni credenciales. Los tests también usan disco local.
# Para usar AWS S3 real (también en local), cambia FILESYSTEM_DISK=s3,
# descomenta AWS_* y define un bucket POR AMBIENTE:
#   autotributo-local-app | autotributo-test-app
#   autotributo-staging-app | autotributo-prod-app   (+ bucket -sri del robot)
# Guía completa: docs/aws-s3-setup.md
FILESYSTEM_DISK=local

# AWS S3 (opcional en local; obligatorio en staging/producción).
# En Laravel Cloud se configuran en el panel, nunca en el repositorio.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=autotributo-local-app
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Broadcasting / WebSockets (Reverb) -------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=autotributo
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Correo ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@autotributo.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Robot SRI (AWS Lambda) --------------------------------------------------
# fake = adaptador local con fixtures (sin AWS). lambda = invocación real.
SRI_ROBOT_DRIVER=fake
SRI_ROBOT_FUNCTION=sri-txt-robot
SRI_ROBOT_REGION=us-east-1
# Bucket del robot para el ambiente local (solo si SRI_ROBOT_DRIVER=lambda).
SRI_ROBOT_OUTPUT_BUCKET=autotributo-local-sri
SRI_ROBOT_OUTPUT_PREFIX=runs
SRI_ROBOT_DEADLINE_SECONDS=840
SRI_ROBOT_CALLBACK_URL="${APP_URL}/api/v1/webhooks/sri-robot"
SRI_ROBOT_CALLBACK_SECRET=change-me-hmac-secret
SRI_ROBOT_PUBLIC_KEY=   # clave pública (base64) para sellar credenciales con sodium_crypto_box_seal

# Clave dedicada para cifrar credenciales SRI (independiente de APP_KEY para
# poder rotar APP_KEY sin perder credenciales). Generar con: openssl rand -base64 32
SRI_CREDENTIALS_KEY=

# --- Clasificación con IA ----------------------------------------------------
LLM_DRIVER=fake                # fake | openai | anthropic
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=20
LLM_MONTHLY_BUDGET_USD=50
LLM_CONFIDENCE_THRESHOLD=0.80
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observabilidad ----------------------------------------------------------
SENTRY_LARAVEL_DSN=
TELESCOPE_ENABLED=true
PULSE_ENABLED=true

# --- Feature flags / límites -------------------------------------------------
SRI_SYNC_MAX_DAYS_PER_RUN=93
SRI_SYNC_MAX_CALLS_PER_MINUTE=6
AI_CLASSIFY_BATCH_SIZE=40
