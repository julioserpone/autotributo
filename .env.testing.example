# Entorno de tests / CI (se copia a .env en GitHub Actions)
APP_NAME=Autotributo
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=0.1.0
APP_MAINTENANCE_DRIVER=file

TENANCY_MODE=single
TENANCY_DEFAULT_SLUG=test

APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=autotributo_test
DB_USERNAME=autotributo
DB_PASSWORD=secret

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Los tests usan disco local (rápido, determinista, sin credenciales).
# Si un test de integración necesita S3, usa Storage::fake() o un bucket
# dedicado de test: autotributo-test-app (nunca staging/producción).
FILESYSTEM_DISK=local

MAIL_MAILER=array

SRI_ROBOT_DRIVER=fake
SRI_ROBOT_CALLBACK_SECRET=test-secret
SRI_CREDENTIALS_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

LLM_DRIVER=fake
LLM_MONTHLY_BUDGET_USD=0

TELESCOPE_ENABLED=false
PULSE_ENABLED=false

BCRYPT_ROUNDS=4
