#!/usr/bin/env sh

set -eu

message_file="$1"
first_line="$(head -n 1 "${message_file}")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if printf '%s' "${first_line}" | grep -Eq '^Merge '; then
    exit 0
fi

if ! printf '%s' "${first_line}" | grep -Eq "${pattern}"; then
    printf '%s\n' "Commit message must follow Conventional Commits, for example:" >&2
    printf '%s\n' "  feat(sri): add signed callback endpoint" >&2
    exit 1
fi
