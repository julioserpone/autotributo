{
    "info": {
        "name": "Autotributo API",
        "description": "Colección de pruebas manuales de la API (base: http://localhost:8000). Usa cookies de sesión; Postman gestiona XSRF-TOKEN automáticamente.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "base_url", "value": "http://localhost:8000" }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": "{{base_url}}/api/v1/auth/login",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"owner@demo.test\",\n  \"password\": \"secret-password\",\n  \"remember\": false\n}"
                        }
                    }
                },
                {
                    "name": "Me",
                    "request": { "method": "GET", "url": "{{base_url}}/api/v1/auth/me" }
                },
                {
                    "name": "Logout",
                    "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/logout" }
                },
                {
                    "name": "Change password",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": "{{base_url}}/api/v1/auth/password",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"current_password\": \"secret-password\",\n  \"password\": \"nueva-clave-123\",\n  \"password_confirmation\": \"nueva-clave-123\"\n}"
                        }
                    }
                },
                {
                    "name": "List sessions",
                    "request": { "method": "GET", "url": "{{base_url}}/api/v1/auth/sessions" }
                },
                {
                    "name": "Login history",
                    "request": { "method": "GET", "url": "{{base_url}}/api/v1/auth/login-history" }
                }
            ]
        },
        {
            "name": "Two Factor",
            "item": [
                {
                    "name": "Enable 2FA",
                    "request": { "method": "POST", "url": "{{base_url}}/api/v1/auth/two-factor/enable" }
                },
                {
                    "name": "Confirm 2FA",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": "{{base_url}}/api/v1/auth/two-factor/confirm",
                        "body": { "mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}" }
                    }
                },
                {
                    "name": "2FA Challenge",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": "{{base_url}}/api/v1/auth/two-factor/challenge",
                        "body": { "mode": "raw", "raw": "{\n  \"code\": \"123456\"\n}" }
                    }
                }
            ]
        },
        {
            "name": "Companies",
            "item": [
                {
                    "name": "List companies",
                    "request": { "method": "GET", "url": "{{base_url}}/api/v1/companies" }
                },
                {
                    "name": "Create company",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "url": "{{base_url}}/api/v1/companies",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"ruc\": \"0602910945001\",\n  \"legal_name\": \"Empresa Demo S.A.\",\n  \"regime\": \"general\"\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Sync",
            "item": [
                {
                    "name": "List sync runs",
                    "request": { "method": "GET", "url": "{{base_url}}/api/v1/sync-runs" }
                },
                {
                    "name": "Start sync run",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Idempotency-Key", "value": "demo-run-1" }
                        ],
                        "url": "{{base_url}}/api/v1/sync-runs",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"company_id\": \"01J0000000000000000000000\",\n  \"periods\": [\"2026-08\"]\n}"
                        }
                    }
                }
            ]
        }
    ]
}