{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "types": [
            "vite/client",
            "node"
        ],
        "paths": {
            "@/*": [
                "./resources/js/*"
            ],
            "#build/ui/*": [
                "./node_modules/.nuxt-ui/ui/*"
            ]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.vue",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        "tests/e2e/**/*.ts",
        "auto-imports.d.ts",
        "components.d.ts"
    ],
    "exclude": [
        "node_modules",
        "public/build",
        "vendor"
    ]
}
