# =============================================================================
# Autotributo — ejemplo de configuración de STAGING en AWS (ADR-0008)
#
# Copiar a `.env` EN LA INSTANCIA EC2 (nunca en el repositorio):
#   cp .env.staging.example .env && chmod 600 .env
#
# Los valores marcados como «generar» se crean una sola vez y se guardan en el
# gestor de secretos de la organización. No usar credenciales de producción ni
# datos reales en staging.
#
# Los valores de este archivo NO se expanden entre sí (Docker Compose los pasa
# literales al contenedor), por eso APP_URL y el callback se escriben completos.
# =============================================================================

# UID/GID del usuario de la instancia (ubuntu = 1000). Los usa Docker Compose
# para construir la imagen y para escribir en ./storage y ./public.
UID=1000
GID=1000

APP_NAME=Autotributo
APP_ENV=staging
APP_KEY=
HASH_DRIVER=argon2id
APP_DEBUG=false
APP_URL=https://autotributo-staging.duckdns.org
APP_VERSION=0.1.0
APP_MAINTENANCE_DRIVER=file

# Hostname público y correo para Let's Encrypt (los usa Caddy).
STAGING_HOSTNAME=autotributo-staging.duckdns.org
ACME_EMAIL=ops@example.com

APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC

# Tenancy (ADR-0006): un solo estudio por despliegue.
TENANCY_MODE=single
TENANCY_DEFAULT_SLUG=staging

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Base de datos (RDS PostgreSQL, staging) ---------------------------------
# Instancia RDS db.t3.micro en la misma VPC que la EC2. No es públicamente
# accesible: usa SSH tunnel para conectarte desde tu Mac.
# Alternativa: definir solo DB_URL con la cadena completa.
DB_CONNECTION=pgsql
DB_HOST=autotributo-staging-db.xxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=autotributo
DB_USERNAME=autotributo
DB_PASSWORD=
DB_SSLMODE=prefer
# DB_URL=postgresql://autotributo:password@autotributo-staging-db.xxxxxxxx.us-east-2.rds.amazonaws.com:5432/autotributo?sslmode=prefer

# --- Caché, sesiones y colas -------------------------------------------------
# Sin Valkey en staging: todo en Postgres (tablas cache/jobs/sessions).
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# --- Almacenamiento -----------------------------------------------------------
# M1 usa el disco de la instancia. Al activar M2/robot real, cambiar a S3 con
# los buckets autotributo-staging-app / autotributo-staging-sri.
FILESYSTEM_DISK=local

# --- Broadcasting / WebSockets (Reverb) --------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=autotributo-staging
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
# El servidor de la app publica eventos contra el contenedor interno.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# El frontend se compila en el host con `npm run build` y Vite lee estas
# variables de este mismo .env. La app key es pública; el secret nunca lleva
# prefijo VITE_.
VITE_APP_NAME=Autotributo
VITE_REVERB_APP_KEY=change-me
VITE_REVERB_HOST=autotributo-staging.duckdns.org
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# --- Correo ------------------------------------------------------------------
# `log` evita enviar correos reales desde staging. Para UAT con correo, usar
# Resend con una API key de staging.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@autotributo-staging.duckdns.org
MAIL_FROM_NAME=Autotributo

# --- Integración SRI ---------------------------------------------------------
# M1 no usa red del SRI ni la Lambda real. `SRI_ENVIRONMENT=1` = pruebas.
SRI_AUTHORIZATION_DRIVER=fake
SRI_AUTHORIZATION_FALLBACK_TO_SRI=false
SRI_AUTHORIZATION_WINDOW_DAYS=45
SRI_ENVIRONMENT=1
SRI_CONNECTION_TIMEOUT=10
SRI_TIMEOUT=30
SRI_RETRY_ATTEMPTS=3
SRI_RETRY_BASE_DELAY_MS=250
SRI_RETRY_MAX_DELAY_MS=5000

# --- Robot SRI (AWS Lambda) --------------------------------------------------
SRI_ROBOT_DRIVER=fake
SRI_ROBOT_FUNCTION=sri-txt-robot-staging
SRI_ROBOT_REGION=us-east-2
SRI_ROBOT_ENVIRONMENT=dev
SRI_ROBOT_OUTPUT_BUCKET=autotributo-staging-sri
SRI_ROBOT_OUTPUT_PREFIX=
SRI_ROBOT_DEADLINE_SECONDS=840
# Estable aunque cambie la IP: apunta al hostname de DuckDNS.
SRI_ROBOT_CALLBACK_URL=https://autotributo-staging.duckdns.org/api/v1/webhooks/sri-robot
SRI_ROBOT_CALLBACK_SECRET=
SRI_ROBOT_CALLBACK_TOLERANCE_SECONDS=300
SRI_ROBOT_CALLBACK_MAX_BYTES=262144
SRI_ROBOT_PUBLIC_KEY=

# Clave dedicada (base64 de 32 bytes) para cifrar credenciales SRI.
# Generar: openssl rand -base64 32
SRI_CREDENTIALS_KEY=
SRI_CREDENTIALS_KEY_VERSION=1

# --- Clasificación con IA ----------------------------------------------------
LLM_DRIVER=fake
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=20
LLM_MONTHLY_BUDGET_USD=0
LLM_CONFIDENCE_THRESHOLD=0.80
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observabilidad ----------------------------------------------------------
SENTRY_LARAVEL_DSN=
TELESCOPE_ENABLED=false
PULSE_ENABLED=false

# --- Feature flags / límites -------------------------------------------------
SRI_SYNC_MAX_DAYS_PER_RUN=93
SRI_SYNC_MAX_CALLS_PER_MINUTE=6
SRI_SYNC_IMPORT_QUEUE=sri
SRI_SYNC_IMPORT_TRIES=3
SRI_SYNC_IMPORT_TIMEOUT=90
SRI_SYNC_CHUNK_SIZE=25
SRI_SYNC_STALE_AFTER_MINUTES=30
SRI_SYNC_ORPHAN_ALERT_THRESHOLD=3
AI_CLASSIFY_BATCH_SIZE=40

# --- AWS S3 (solo al activar M2/robot real) ----------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-2
# AWS_BUCKET=autotributo-staging-app
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
